{
  "name": "Leaderboard",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "all_time"
      ],
      "default": "all_time"
    },
    "total_won": {
      "type": "number",
      "default": 0
    },
    "win_rate": {
      "type": "number",
      "default": 0
    },
    "rank": {
      "type": "number"
    },
    "streak": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "period"
  ]
}