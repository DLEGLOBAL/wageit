{
  "name": "ActivityFeed",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "wager_created",
        "wager_won",
        "wager_lost",
        "achievement_unlocked",
        "friend_added",
        "level_up"
      ]
    },
    "description": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_email",
    "activity_type",
    "description"
  ]
}