{
  "name": "Message",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "room_id",
    "sender_email",
    "content"
  ]
}