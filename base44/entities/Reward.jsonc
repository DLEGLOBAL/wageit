      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cost_points": {
      "type": "number"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "cosmetic",
        "feature",
        "badge",
        "boost"
      ],
      "default": "cosmetic"
    },
    "icon": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "cost_points",
    "reward_type"
  ]
}