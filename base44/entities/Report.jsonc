{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string"
    },
    "reported_email": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "harassment",
        "fraud",
        "inappropriate_content",
        "underage",
        "other"
      ]
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "action_taken",
        "dismissed"
      ],
      "default": "pending"
    },
    "wager_id": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "reported_email",
    "reason"
  ]
}